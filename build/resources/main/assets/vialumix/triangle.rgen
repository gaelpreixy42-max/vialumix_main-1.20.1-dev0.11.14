#version 460
#extension GL_EXT_ray_tracing : require
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(set = 0, binding = 1) uniform accelerationStructureEXT topLevelAS;
layout(location = 0) rayPayloadEXT vec3 radiance;

void main() {
    vec2 uv = (vec2(gl_LaunchIDEXT.xy) + vec2(0.5)) / vec2(gl_LaunchSizeEXT.xy);
    vec2 screen = uv * 2.0 - 1.0;
    vec3 origin = vec3(0.0, 0.0, 0.0);
    vec3 direction = normalize(vec3(screen.x, -screen.y, -1.5));
    radiance = vec3(0.015, 0.025, 0.045);
    traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0,
                origin, 0.001, direction, 100.0, 0);
    imageStore(outputImage, ivec2(gl_LaunchIDEXT.xy), vec4(radiance, 1.0));
}
