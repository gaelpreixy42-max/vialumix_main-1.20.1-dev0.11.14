#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D outA; // shadow, solidDist, waterDist, flags
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outB; // reflection hit albedo, hit
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D outC; // sunlit, emissive, hitDist, skyVisibility
layout(set = 0, binding = 3) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D outD;  // sun bounce (rgb), AO visibility (a)
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D outE; // emissive bounce (rgb), history distance (a)
layout(set = 0, binding = 14, rgba16f) uniform writeonly image2D outF; // native mode: final lit colour (rgb), primary distance (a)
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D histD;
layout(set = 0, binding = 12, rgba16f) uniform readonly image2D histE;
layout(set = 0, binding = 4, std140) uniform Frame {
    vec4 camPos;      // xyz scene-relative camera, w = time (s)
    vec4 camRight;    // xyz right * tanHalfFovX, w = origin X (absolute world)
    vec4 camUp;       // xyz up * tanHalfFovY,    w = origin Y
    vec4 camForward;  // xyz forward,             w = origin Z
    vec4 sunDir;      // xyz towards light, w = soft shadow cone radius
    vec4 misc;        // x reflections, y shadows, z max distance, w frame index
    vec4 flags;       // x camera in water, y wave strength, z AO/GI enabled
    vec4 prevPos;     // previous camera (scene-relative to the current origin)
    vec4 prevRight;   // previous right * tanHalfFovX
    vec4 prevUp;      // previous up * tanHalfFovY
    vec4 prevForward;
    vec4 skyColor;    // rgb sky radiance, w = native lighting mode flag
    vec4 sunColor;    // rgb sun irradiance, w = emissive scale
    vec4 skyHorizon;  // rgb horizon sky radiance
} f;

struct Hit { float t; vec3 n; vec3 albedo; float emissive; };
layout(location = 0) rayPayloadEXT Hit hit;
layout(location = 1) rayPayloadEXT float visibility;

// Sky radiance seen along direction d (zenith/horizon gradient, soft sun glow, dim ground bounce below the horizon).
vec3 skyRadiance(vec3 d, float rough) {
    float h = clamp(d.y, 0.0, 1.0);
    vec3 sky = mix(f.skyHorizon.rgb, f.skyColor.rgb, pow(h, 0.45));
    sky = d.y < 0.0 ? f.skyHorizon.rgb * mix(0.55, 0.25, clamp(-d.y * 2.0, 0.0, 1.0)) : sky;
    float s = max(dot(d, f.sunDir.xyz), 0.0);
    float e = mix(600.0, 40.0, rough);
    return sky + f.sunColor.rgb * (pow(s, 24.0) * 0.012 + pow(s, e) * 1.5 * (e + 2.0) / 602.0);
}

// Diffuse sky (no sun disc): what bounce rays see. The sun is handled by explicit shadow rays, so sampling it here would only add fireflies.
vec3 skyDiffuse(vec3 d) {
    float h = clamp(d.y, 0.0, 1.0);
    vec3 sky = mix(f.skyHorizon.rgb, f.skyColor.rgb, pow(h, 0.45));
    return d.y < 0.0 ? f.skyHorizon.rgb * mix(0.55, 0.25, clamp(-d.y * 2.0, 0.0, 1.0)) : sky;
}

float halton(uint index, uint base) {
    float result = 0.0, fraction = 1.0 / float(base);
    while (index > 0u) { result += fraction * float(index % base); index /= base; fraction /= float(base); }
    return result;
}

float ign(vec2 p, float frame) {
    p += 5.588238 * frame;
    return fract(52.9829189 * fract(0.06711056 * p.x + 0.00583715 * p.y));
}

vec3 coneSample(vec3 dir, float radius, vec2 xi) {
    vec3 up = abs(dir.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 t = normalize(cross(up, dir));
    vec3 b = cross(dir, t);
    float a = 6.2831853 * xi.x;
    float r = sqrt(xi.y) * radius;
    return normalize(dir + t * (cos(a) * r) + b * (sin(a) * r));
}

vec3 cosineSample(vec3 n, vec2 xi) {
    vec3 up = abs(n.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 t = normalize(cross(up, n));
    vec3 b = cross(n, t);
    float a = 6.2831853 * xi.x;
    float r = sqrt(xi.y);
    return normalize(t * (cos(a) * r) + b * (sin(a) * r) + n * sqrt(max(1.0 - xi.y, 0.0)));
}

float traceVisibility(vec3 origin, vec3 direction, float tMax) {
    visibility = 0.0;
    traceRayEXT(tlas,
                gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                0x01, 0, 0, 1, origin, 0.0, direction, tMax, 1);
    return visibility;
}

// Animated water normal. Each wave octave fades out once a pixel's footprint on the water becomes comparable to its
// wavelength (finer ripples than a pixel only alias into moire rings and shimmer); `footprint` is in blocks.
vec3 waveNormal(vec2 p, float t, float strength, float footprint) {
    vec2 g = vec2(0.0);
    float a, w;
    a = p.x * 1.31 + p.y * 0.77 + t * 1.10;  w = 1.0 - smoothstep(0.6, 2.2, footprint); g += vec2(1.31, 0.77) * cos(a) * 0.050 * w;
    a = p.x * -0.83 + p.y * 1.57 + t * 0.85; w = 1.0 - smoothstep(0.7, 2.6, footprint); g += vec2(-0.83, 1.57) * cos(a) * 0.040 * w;
    a = p.x * 2.90 + p.y * -2.10 + t * 1.90; w = 1.0 - smoothstep(0.25, 1.0, footprint); g += vec2(2.90, -2.10) * cos(a) * 0.016 * w;
    a = p.x * -3.70 + p.y * -2.60 + t * 2.30; w = 1.0 - smoothstep(0.15, 0.6, footprint); g += vec2(-3.70, -2.60) * cos(a) * 0.010 * w;
    return normalize(vec3(-g.x * strength, 1.0, -g.y * strength));
}

// Ground footprint (blocks) of one pixel for a primary ray hitting a horizontal surface at distance t.
float pixelFootprint(float t, vec3 dir) {
    float pixelAngle = 2.0 * length(f.camUp.xyz) / float(gl_LaunchSizeEXT.y);
    return t * pixelAngle / max(abs(dir.y), 0.02);
}

void main() {
    ivec2 px = ivec2(gl_LaunchIDEXT.xy);
    vec2 size = vec2(gl_LaunchSizeEXT.xy);
    // Sub-pixel jitter (native mode only) so the temporal pass anti-aliases edges.
    vec2 jitter = f.skyColor.w > 0.5 ? vec2(halton((uint(f.misc.w) & 15u) + 1u, 2u), halton((uint(f.misc.w) & 15u) + 1u, 3u)) - 0.5 : vec2(0.0);
    jitter *= 0.5;
    vec2 ndc = (vec2(px) + 0.5 + jitter) / size * 2.0 - 1.0;
    vec3 org = f.camPos.xyz;
    vec3 dir = normalize(f.camForward.xyz + f.camRight.xyz * ndc.x + f.camUp.xyz * ndc.y);
    float maxD = f.misc.z;
    float frame = f.misc.w;
    vec2 xi0 = vec2(ign(vec2(px), frame), ign(vec2(px) + vec2(31.7, 11.3), frame));
    vec2 xi1 = vec2(ign(vec2(px) + vec2(7.1, 53.9), frame), ign(vec2(px) + vec2(91.3, 3.7), frame));

    // Primary opaque surface (everything except water).
    hit.t = -1.0;
    traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0x01, 0, 0, 0, org, 0.0, dir, maxD, 0);
    Hit solid = hit;

    // Water surface in front of the opaque surface.
    Hit water; water.t = -1.0; water.n = vec3(0, 1, 0); water.albedo = vec3(0); water.emissive = 0.0;
    if (f.flags.x < 0.5) {
        hit.t = -1.0;
        float limit = solid.t > 0.0 ? solid.t : maxD;
        traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0x02, 0, 0, 0, org, 0.0, dir, limit, 0);
        water = hit;
    }

    float shadow = 1.0;
    if (solid.t > 0.0 && f.misc.y > 0.5) {
        vec3 p = org + dir * solid.t + solid.n * 0.004;
        vec3 l0 = coneSample(f.sunDir.xyz, f.sunDir.w, xi0);
        vec3 l1 = coneSample(f.sunDir.xyz, f.sunDir.w, vec2(fract(xi0.x + 0.5), fract(xi0.y + 0.5)));
        shadow = 0.5 * (traceVisibility(p, l0, 512.0) + traceVisibility(p, l1, 512.0));
    }

    // ---- Ambient occlusion + one-bounce diffuse GI (temporally accumulated, 1/4 of the pixels traced per frame) ----
    vec4 giD = vec4(0.0, 0.0, 0.0, 1.0);
    vec4 giE = vec4(0.0);
    if (solid.t > 0.0 && f.flags.z > 0.5) {
        vec3 p = org + dir * solid.t;
        vec3 rel = p - f.prevPos.xyz;
        float depthPrev = dot(rel, f.prevForward.xyz);
        vec4 hD = vec4(0.0), hE = vec4(0.0);
        bool histValid = false;
        if (depthPrev > 0.01 && frame > 0.5) {
            vec2 ndcPrev = vec2(dot(rel, f.prevRight.xyz) / (dot(f.prevRight.xyz, f.prevRight.xyz) * depthPrev),
                                dot(rel, f.prevUp.xyz) / (dot(f.prevUp.xyz, f.prevUp.xyz) * depthPrev));
            vec2 uvPrev = ndcPrev * 0.5 + 0.5;
            if (all(greaterThanEqual(uvPrev, vec2(0.0))) && all(lessThan(uvPrev, vec2(1.0)))) {
                ivec2 hp = ivec2(uvPrev * size);
                hD = imageLoad(histD, hp);
                hE = imageLoad(histE, hp);
                float expected = length(rel);
                histValid = hE.a > 0.0 && abs(hE.a - expected) < max(0.12, 0.03 * expected);
            }
        }
        bool nat = f.skyColor.w > 0.5;
        bool doTrace = !histValid || ((px.x & 1) + 2 * (px.y & 1)) == (int(frame) & 3);
        if (doTrace) {
            vec3 acc = vec3(0.0), emi = vec3(0.0);
            float ao = 0.0;
            const int RAYS = 2;
            for (int i = 0; i < RAYS; i++) {
                vec2 xi = vec2(ign(vec2(px) + vec2(17.0 * float(i), 5.0), frame), ign(vec2(px) + vec2(3.0, 29.0 * float(i + 1)), frame));
                vec3 gd = cosineSample(solid.n, xi);
                vec3 go = p + solid.n * 0.004;
                hit.t = -1.0;
                traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0x01, 0, 0, 0, go, 0.0, gd, 40.0, 0);
                if (hit.t < 0.0) {
                    ao += 1.0;
                    if (nat) acc += min(skyDiffuse(gd), vec3(4.0));
                } else {
                    ao += clamp(hit.t / 5.0, 0.0, 1.0);
                    vec3 hp = go + gd * hit.t + hit.n * 0.004;
                    float ndl = max(dot(hit.n, f.sunDir.xyz), 0.0);
                    float lit = 0.0;
                    if (ndl > 0.0 && f.misc.y > 0.5) lit = ndl * traceVisibility(hp, coneSample(f.sunDir.xyz, f.sunDir.w, xi.yx), 512.0);
                    if (nat) {
                        acc += min(hit.albedo * (lit * f.sunColor.rgb + f.skyColor.rgb * 0.10), vec3(8.0));
                        emi += hit.albedo * hit.emissive * f.sunColor.w;
                    } else {
                        acc += hit.albedo * lit;
                        emi += hit.albedo * hit.emissive;
                    }
                }
            }
            int mask = nat ? 3 : int(f.flags.w + 0.5); // bit0 = AO, bit1 = GI
            vec4 newD = vec4(((mask & 2) != 0 ? acc : vec3(0.0)) / float(RAYS), (mask & 1) != 0 ? ao / float(RAYS) : 1.0);
            vec4 newE = vec4(((mask & 2) != 0 ? emi : vec3(0.0)) / float(RAYS), 0.0);
            float w = histValid ? 0.30 : 1.0;
            giD = mix(hD, newD, w);
            giE = mix(hE, newE, w);
        } else {
            giD = hD;
            giE = hE;
        }
        giE.a = solid.t;
    }

    float flagBits = 0.0;
    if (solid.t > 0.0) flagBits += 1.0;
    if (water.t > 0.0) flagBits += 2.0;

    vec4 reflB = vec4(0.0);
    vec4 reflC = vec4(0.0);
    bool hasPrimary = (water.t > 0.0) || (solid.t > 0.0);
    if (f.misc.x > 0.5 && hasPrimary) {
        bool isWater = water.t > 0.0;
        float t0 = isWater ? water.t : solid.t;
        vec3 n = isWater ? waveNormal((org + dir * t0).xz + vec2(f.camRight.w, f.camForward.w), f.camPos.w, f.flags.y, pixelFootprint(t0, dir)) : solid.n;
        if (dot(n, dir) > 0.0) n = -n;
        vec3 origin = org + dir * t0 + n * 0.004;
        vec3 r = reflect(dir, n);
        if (r.y < -0.2 && isWater) r.y = -r.y; // water never reflects the ground below it
        hit.t = -1.0;
        traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0x01, 0, 0, 0, origin, 0.0, r, maxD, 0);
        if (hit.t > 0.0) {
            vec3 hp = origin + r * hit.t + hit.n * 0.004;
            float ndl = max(dot(hit.n, f.sunDir.xyz), 0.0);
            float lit = 0.0;
            if (ndl > 0.0 && f.misc.y > 0.5) lit = ndl * traceVisibility(hp, coneSample(f.sunDir.xyz, f.sunDir.w, xi1), 512.0);
            float sky = traceVisibility(hp, cosineSample(hit.n, xi0.yx), 64.0);
            reflB = vec4(hit.albedo, 1.0);
            reflC = vec4(lit, hit.emissive, hit.t, sky);
            flagBits += 4.0;
        }
    }

    // ---- Native (shaderpack-less) lighting: the RT result is the final image ----
    vec4 nativeOut = vec4(0.0);
    if (f.skyColor.w > 0.5) {
        vec3 sunC = f.sunColor.rgb, skyC = f.skyColor.rgb;
        vec3 solidCol = vec3(0.0);
        if (solid.t > 0.0) {
            float ndl = max(dot(solid.n, f.sunDir.xyz), 0.0);
            solidCol = solid.albedo * (sunC * ndl * shadow + giD.rgb + giE.rgb) + solid.albedo * solid.emissive * f.sunColor.w;
        }
        if (water.t > 0.0) {
            vec3 wn = waveNormal((org + dir * water.t).xz + vec2(f.camRight.w, f.camForward.w), f.camPos.w, f.flags.y * 0.45, pixelFootprint(water.t, dir));
            if (dot(wn, dir) > 0.0) wn = -wn;
            vec3 r = normalize(reflect(dir, wn));
            r.y = max(r.y, 0.01);
            vec3 reflCol = reflB.a > 0.5
                ? reflB.rgb * (reflC.r * sunC + skyC * 0.30) + reflB.rgb * reflC.g * f.sunColor.w
                : skyRadiance(r, smoothstep(15.0, 120.0, water.t));
            float fres = 0.02 + 0.98 * pow(1.0 - clamp(dot(-dir, wn), 0.0, 1.0), 5.0);
            float depthW = solid.t > 0.0 ? max(solid.t - water.t, 0.0) : 40.0;
            vec3 sigma = vec3(0.95, 0.30, 0.17);
            vec3 trans = exp(-sigma * depthW);
            vec3 under = solid.t > 0.0 ? solidCol * trans * trans : vec3(0.0); // light is absorbed on the way in and on the way out
            vec3 scatter = vec3(0.03, 0.22, 0.30) * (skyC * 0.45 + sunC * 0.04 * max(f.sunDir.y, 0.1)) * (1.0 - exp(-0.22 * depthW));
            nativeOut = vec4(mix(under + scatter, reflCol, fres), water.t);
        } else if (solid.t > 0.0) {
            nativeOut = vec4(solidCol, solid.t);
        }
        if (nativeOut.a > 0.0) {
            // Aerial perspective toward the horizon sky colour.
            float fog = 1.0 - exp(-nativeOut.a * 0.0011);
            nativeOut.rgb = mix(nativeOut.rgb, f.skyHorizon.rgb * 1.1, fog);
            float sceneRadius = (f.misc.z - 24.0) / 1.08;
            nativeOut.rgb = mix(nativeOut.rgb, f.skyHorizon.rgb * 1.1, smoothstep(sceneRadius * 0.5, sceneRadius * 0.98, nativeOut.a));
        }
    }
    imageStore(outF, px, nativeOut);
    imageStore(outA, px, vec4(shadow, max(solid.t, 0.0), max(water.t, 0.0), flagBits));
    imageStore(outB, px, reflB);
    imageStore(outC, px, reflC);
    imageStore(outD, px, giD);
    imageStore(outE, px, giE);
}
